PORT=5000
DATABASE_URL=
NEXT_PUBLIC_AI_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:5000

JWT_SECRET=your-secret-here
FRONTEND_URL=http://localhost:3000

# Sign-in (Better Auth). The secret signs session cookies (falls back to
# JWT_SECRET); the URL is the public site, where the session cookie lives.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Where the Next server reaches the API (it forwards /api and /uploads there).
API_INTERNAL_URL=http://localhost:5000
# Proxies in front of the API (comma-separated IPs/CIDRs) skipped when finding a
# visitor's IP for rate limits. Defaults to loopback and private ranges.
TRUSTED_PROXIES=

# Email
FROM_EMAIL=noreply@yourdomain.com
# Sender name inboxes show (default AI Amplify)
FROM_NAME=AI Amplify
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# AWS SES (prod only)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI assistant (potential-ai) — shared service-JWT secret. Must equal the
# SERVICE_JWT_SECRET configured on the potential-ai deployment. Used to mint
# short-lived per-user tokens via GET /api/account/copilot-token.
COPILOT_SERVICE_JWT_SECRET=

# Learner messages: bell notifications, dashboard banners and announcement
# emails to learners. Off until the client signs off ("true" turns them on).
LEARNER_NOTIFICATIONS_ENABLED=false
# Reminder and booking emails for mentor sessions and live events. Off until sign-off.
REMINDER_EMAILS_ENABLED=false

# Zoom for live events (Server-to-Server OAuth app). Leave empty to run without
# Zoom (admins use another link or an in-person venue). In development an
# in-memory Zoom stands in; ZOOM_ADAPTER=mock forces it.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
# Verifies Zoom's webhook calls to /api/webhooks/zoom (meeting started/ended).
ZOOM_WEBHOOK_SECRET_TOKEN=

# AI Insights / AI Dashboard (optional). Unset: the agent's SQL runs on the main
# connection in READ ONLY transactions behind the SQL guard. Set it to a
# connection as the amplify_ai_readonly role (server/db/aiViews/000_role.sql.example)
# so the database itself also refuses anything outside the `ai` views.
AI_READONLY_DATABASE_URL=
