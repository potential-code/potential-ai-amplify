{{#> layout}}

  <p style="margin:0 0 20px;font-family:'Noto Sans',system-ui,sans-serif;font-size:15px;line-height:1.65;color:#1A0A12;">
    Hi <strong>{{name}}</strong>,
  </p>

  <p style="margin:0 0 20px;font-family:'Noto Sans',system-ui,sans-serif;font-size:15px;line-height:1.65;color:#1A0A12;">
    A reminder: <strong style="color:#652d90;">{{title}}</strong> starts {{startsIn}}.
  </p>

  <table cellpadding="0" cellspacing="0" border="0" role="presentation" width="100%" style="margin:0 0 24px;">
    <tr>
      <td style="background-color:#FDF5F9;border-left:4px solid #652d90;border-radius:0 8px 8px 0;padding:16px 20px;">
        <p style="margin:0 0 4px;font-family:'Noto Sans',system-ui,sans-serif;font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#652d90;">When</p>
        <p style="margin:0;font-family:'Noto Sans',system-ui,sans-serif;font-size:15px;font-weight:600;color:#1A0A12;">{{when}}</p>
        {{#if location}}
        <p style="margin:12px 0 4px;font-family:'Noto Sans',system-ui,sans-serif;font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#652d90;">Where</p>
        <p style="margin:0;font-family:'Noto Sans',system-ui,sans-serif;font-size:15px;font-weight:600;color:#1A0A12;">{{location}}</p>
        {{/if}}
        {{#if meetingId}}
        <p style="margin:12px 0 0;font-family:'Noto Sans',system-ui,sans-serif;font-size:13px;color:#4B5563;">Zoom meeting ID {{meetingId}}{{#if passcode}} · passcode {{passcode}}{{/if}}</p>
        {{/if}}
      </td>
    </tr>
  </table>

  {{#if joinUrl}}
  <table cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin:0 0 16px;">
    <tr>
      <td align="center" bgcolor="#652d90" style="background-color:#652d90;border-radius:8px;mso-padding-alt:0;">
        <a href="{{joinUrl}}" target="_blank" style="display:inline-block;padding:14px 32px;font-family:'Noto Sans',system-ui,sans-serif;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:8px;mso-padding-alt:14px 32px;">Join the event</a>
      </td>
    </tr>
  </table>
  {{#if personal}}
  <p style="margin:0 0 20px;font-family:'Noto Sans',system-ui,sans-serif;font-size:13px;line-height:1.6;color:#6B7280;">This link is yours alone and records that you attended, so please don't forward it.</p>
  {{/if}}
  {{else}}
  {{#unless location}}
  <p style="margin:0 0 20px;font-family:'Noto Sans',system-ui,sans-serif;font-size:14px;line-height:1.6;color:#4B5563;">Your join link will be on the Events page in AI Amplify.</p>
  {{/unless}}
  {{/if}}

{{/layout}}
